{
  "manifest_version": 3,
  "name": "AI更易办",
  "version": "0.1.2",
  "description": "让事更更容易办！",
  "icons": {
    "16": "assets/icons/icon-16.png",
    "32": "assets/icons/icon-32.png",
    "48": "assets/icons/icon-48.png",
    "128": "assets/icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://aieban.whu.edu.cn/ebanbenke/*",
        "http://aieban.whu.edu.cn/ebanbenke/*",
        "https://aieban.whu.edu.cn/eban/*",
        "http://aieban.whu.edu.cn/eban/*"
      ],
      "js": [
        "src/core/constants.js",
        "src/core/preferences.js",
        "src/core/frames.js",
        "src/core/detect.js",
        "src/core/logout.js",
        "src/layout/topbar.js",
        "src/layout/sidebar.js",
        "src/pages/common.js",
        "src/pages/leave.js",
        "src/pages/datepicker.js",
        "src/pages/ideology.js",
        "src/pages/grade-guide.js",
        "src/pages/attendance.js",
        "src/pages/clothing.js",
        "src/pages/party.js",
        "src/pages/login.js",
        "src/pages/annual-award.js",
        "src/content.js"
      ],
      "css": ["src/styles.css"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "assets/sai-emblem.png",
        "assets/sai-emblem-white.png"
      ],
      "matches": [
        "https://aieban.whu.edu.cn/*",
        "http://aieban.whu.edu.cn/*"
      ]
    }
  ]
}
