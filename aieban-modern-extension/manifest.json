{
  "manifest_version": 3,
  "name": "AI更易办",
  "version": "0.1.0",
  "description": "让事更更容易办！",
  "content_scripts": [
    {
      "matches": [
        "https://aieban.whu.edu.cn/ebanbenke/*",
        "http://aieban.whu.edu.cn/ebanbenke/*"
      ],
      "js": ["src/content.js"],
      "css": ["src/styles.css"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "assets/sai-emblem.png",
        "assets/sai-emblem-white.png"
      ],
      "matches": [
        "https://aieban.whu.edu.cn/*",
        "http://aieban.whu.edu.cn/*"
      ]
    }
  ]
}
